<script>
document.addEventListener("DOMContentLoaded", function () {
    let shopifyForm = document.querySelector("form[action='/account']");
    let mailchimpForm = document.querySelector("#mc-embedded-subscribe-form");

    if (shopifyForm && mailchimpForm) {
        shopifyForm.addEventListener("submit", function (event) {
            event.preventDefault(); // Prevent default Shopify form submission

            // Get Shopify Form Data
            let email = document.querySelector("input[name='customer[email]']").value;
            let firstName = document.querySelector("input[name='customer[first_name]']").value;
            let lastName = document.querySelector("input[name='customer[last_name]']").value;

            // Auto-Fill Mailchimp Form
            document.querySelector("#mce-EMAIL").value = email;
            document.querySelector("#mce-FNAME").value = firstName;
            document.querySelector("#mce-LNAME").value = lastName;

            // Submit Mailchimp Form First
            mailchimpForm.submit();

            // Delay Shopify Form Submission to Avoid Conflicts
            setTimeout(function () {
                shopifyForm.submit();
            }, 2000); // 2-second delay to allow Mailchimp to process
        });
    }
});
</script>




