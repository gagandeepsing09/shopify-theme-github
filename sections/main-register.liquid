<div id="template">
  <div id="customer">
	  <!-- Create Customer -->
	  <div id="create-customer">
	    <div class="template_header">
	      <h2 class="title">{{ 'customer.register.title' | t }}</h2>
	    </div>

	    {% form 'create_customer' %}
	      {{ form.errors | default_errors }}

	      <div class="clearfix large_form custom__login-form">
            <label class="custom__login-labels" style="display: block !important;">First Name</label>
	        {% comment %}<label for="first_name" class="login">{{ 'customer.register.first_name' | t }}</label>{% endcomment %}
	        <input type="text" value="" name="customer[first_name]" id="first_name" class="large custom__login-input" size="30" />
	      </div>

	      <div class="clearfix large_form custom__login-form">
            <label class="custom__login-labels" style="display: block !important;">Last Name</label>
	        <label for="last_name" class="login">{{ 'customer.register.last_name' | t }}</label>
	        <input type="text" value="" name="customer[last_name]" id="last_name" class="large custom__login-input" size="30" />
	      </div>

	      <div class="clearfix large_form custom__login-form">
            <label class="custom__login-labels" style="display: block !important;">Email</label>
	        <label for="email" class="login">{{ 'customer.register.email' | t }}</label>
	        <input type="email" value="" name="customer[email]" id="email" class="large custom__login-input" size="30" />
	      </div>

	      <div class="clearfix large_form custom__login-form">
            <label class="custom__login-labels" style="display: block !important;">Password</label>
	        <label for="password" class="login">{{ 'customer.register.password' | t }}</label>
	        <input type="password" value="" name="customer[password]" id="password" class="large password custom__login-input" size="30" />
	      </div>
 <div class="clearfix large_form custom__login-form">
        <label class="custom__login-labels">Mobile Phone</label>
        <input type="text" name="customer[phone]" id="phone" class="large custom__login-input" />
    </div>

    <div class="clearfix large_form custom__login-form">
        <label class="custom__login-labels">Your Preferred Store</label>
        <select name="customer[store_preference]" id="store_preference">
            <option value="San Francisco, CA">San Francisco, CA</option>
            <option value="Culver City, CA">Culver City, CA</option>
            <option value="Denver, CO">Denver, CO</option>
            <option value="San Jose, CA">San Jose, CA</option>
            <option value="Seattle, WA">Seattle, WA</option>
            <option value="No preference">No preference</option>
        </select>
    </div>

    <div class="clearfix large_form custom__login-form">
        <label class="custom__login-labels">How did you hear about us?</label>
        <select name="customer[awareness]" id="awareness">
            <option value="In store">In store</option>
            <option value="Friends or family">Friends or family</option>
            <option value="Event">Event</option>
            <option value="Social Media">Social Media</option>
            <option value="Google">Google</option>
            <option value="Media">Media</option>
            <option value="Print advertising">Print advertising</option>
            <option value="Email">Email</option>
            <option value="Other">Other</option>
        </select>
    </div>
	      <div class="action_bottom">
	        <input class="btn" type="submit" value="{{ 'customer.register.submit' | t }}" />
	        <span class="note">or <a href="{{ shop.url }}">{{ 'customer.register.cancel' | t }}</a></span>
	      </div>
          
	    {% endform %}
	  </div><!-- /#create-customer -->
  </div>
</div>

<script>
document.getElementById("custom-registration-form").addEventListener("submit", function(e) {
    e.preventDefault(); // Stop default form submission

    let formData = new FormData(this);

    // Send Data to Mailchimp
    fetch("https://aldeahome.us1.list-manage.com/subscribe/post?u=775d2b62c205b23c8c92138b8&id=fa9eee8080", {
        method: "POST",
        body: formData,
        mode: "no-cors"
    }).then(() => {
        console.log("Mailchimp Submission Successful");

        // After Mailchimp, send data to Shopify
        fetch("/account", {
            method: "POST",
            body: new FormData(this)
        }).then(() => {
            console.log("Shopify Registration Successful");
            alert("Registration successful!");
            window.location.href = "/account"; // Redirect to account page
        }).catch(error => console.error("Shopify Error:", error));
    }).catch(error => console.error("Mailchimp Error:", error));
});
</script>